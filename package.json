{
  "name": "atonota-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Atonota platformunun ayrı arayüzü",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --mode e2e",
    "dev:yerel": "vite --mode yerel --host localhost --port 5180",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview --port 4173 --strictPort",
    "perf:initial-load": "node scripts/initial-load.mjs",
    "lint": "eslint . && prettier --check . && npm run check:motion",
    "check:motion": "node scripts/motion-gate.mjs",
    "check:tr-comments": "node scripts/tr-comments.mjs",
    "format": "prettier --write .",
    "typecheck": "npm run api:types:check && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "api:types": "node contracts/generate-types.mjs",
    "api:types:check": "node contracts/generate-types.mjs --check",
    "contracts:sync": "node contracts/sync.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ant-design/x": "1.6.1",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "antd": "5.29.3",
    "dayjs": "1.11.23",
    "openapi-fetch": "0.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
